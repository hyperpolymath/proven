# SPDX-License-Identifier: MPL-2.0
# META.a2ml — Project meta-information

[metadata]
project = "proven"
author = "Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>"
license = "MPL-2.0"
standard = "RSR 2026"
last-updated = "2026-11-16"

[architecture-decisions]
decisions = [
  { id = "ADR-LIFECYCLE-20261124", title = "Scoped lifecycle evidence and source-bound receipt", status = "accepted-scoped-validation", date = "2026-11-24", body = "The pending validation recorded in ADR-007 is superseded for the Linux lifecycle slice: production Idris proof checks, forged-proof rejection, RefC runtime, static/shared builds, actual C/Rust consumers, concurrency, standalone unavailability and generated-result corruption controls passed. Static consumer linkage required the explicit Idris support archive and UBSan runtime; failed and successful runs are retained. These results do not formally prove Zig memory safety or compiler/ABI correspondence. Each artifact still misses 60 of 66 required Rustler names. Receipts remain in Proven; Mathesis may catalogue an ungraded engineering demonstration after signed source binding. See docs/status/LIFECYCLE-PROOF-STATUS.adoc." },
  { id = "ADR-007", title = "Canonical lifecycle ABI and production RefC state protocol", status = "accepted-design-validation-pending", date = "2026-11-16", body = "Align proven_init/deinit/is_initialized with the existing C/Rust/Rustler status/void/bool no-argument contract; mark the incompatible Zig correction ABI 2. Legacy example handles get distinct creation/query names. Full native lifecycle calls a production Idris transition entrypoint through the pinned bridge under a mutex; standalone initialization returns unavailable. Proof bodies connect that same wire function to state transitions, with no new axioms, but have not been checked. Error messages are borrowed comptime static literals rather than undocumented allocations. Shared and static builds plus typed C/Rust consumers and generated-result corruption controls are drafted. Heavy validation waits for BotMania's slot; no new PASS or complete ABI claim is made. Rust Creusot/Pearlite wrapper verification and complementary Verus obligations remain pending. See docs/remediation/2026-11-16-native-abi-draft.md." },
  { id = "ADR-006", title = "Checked nonce domain, entropy containment and new pinned native bridge", status = "accepted", date = "2026-11-16", body = "counterNonce preserves its 96-bit format but returns Either, rejects counters above 2^32-1 and checks that accepted encoding decodes to the original counter. Total production-linked round-trip/injectivity proofs and positive endpoint witnesses replace the false unrestricted uniqueness declaration. Counter/key/prefix lifecycle remains pending. Missing entropy and nontrivial shuffle fail explicitly; these are containment proofs, not CSPRNG proofs. Historic bridge source was not recovered; the user authorized creating a new private hyperpolymath/language-bridges repository. Its signed commit 8f4b082c52508ab6276946d61b660e7d9b97f35f is pinned as a submodule. It marshals real RefC values, with ownership/encoding runtime checks and a corrupted-generated-result negative control. It has no general Zig memory-safety proof. PR #236 is incorporated locally. Native nonce/entropy calls pass and the full static library builds, but the actual Rustler gate rejects 61 missing symbols and initialization types remain incompatible. Hosted CI has not run. See docs/remediation/2026-11-16-native-nonce.md." },
  { id = "ADR-005", title = "JWT containment and production-indexed SQL lexical contracts", status = "accepted", date = "2026-11-16", body = "JWT creation and authentication fail explicitly until real cryptography and faithful serialization exist. Total generic proofs rule out successful API results; impossible-premise compatibility implications are not cryptographic correctness. SQL production rendering constructs a quote-mode-indexed encoding relation and full-literal representation witness. Legacy NUL removal is explicit; checked rendering rejects NUL. Strict validation excludes SQLRaw in positional and named parameters. False quote-free and universal injection-safety witnesses are withdrawn, not counted as discharged. SQLite integration uses Julia and the real SQLite API to preserve exact CR/LF bytes; other database receivers and driver binding remain pending. Correction to ADR-003's historical assumption: the configured language-bridges repository returned 404, so its canonical location and private/public status are unresolved; credentials are premature. Preserve PR #236. See docs/remediation/2026-11-16-jwt-sql.md." },
  { id = "ADR-004", title = "Evidence-bearing proof acceptance and fail-closed unavailable authentication", status = "accepted", date = "2026-11-16", body = "ECHIDNA validates only the closed Nat/Bool equality fragment for which the concrete Idris checker constructs a goal-indexed semantic certificate. Syntax diagnostics use a distinct result type. Arbitrary backend soundness and unconditional validity constructors are removed. Webhook authentication is explicitly unavailable and cannot mutate replay state; its evidence type requires accepted execution. Full-character password comparison replaces lossy byte narrowing, with functional proofs and no machine-timing claim. Fresh-source proof checks, runtime assertions and negative compilation fixtures run in proof-check CI. Unsupported logic, actual cryptography and native refinement remain pending. See docs/remediation/2026-11-16-plan.md." },
  { id = "ADR-001", title = "OWED-with-justification convention for bodyless declarations in Proofs.idr files", status = "accepted", date = "2026-05-20", body = "Bodyless type signatures (implicit postulates) are made discoverable via triple-pipe doc-comment naming the claim + Idris2 0.8.0 blocker + discharge condition, plus a leading `0 ` erased-multiplicity marker, plus the original bare signature. The `postulate` keyword is NOT used (zero Proofs.idr files use it). Canonical example: src/Proven/SafeChecksum/Proofs.idr. Reference: hyperpolymath/standards#158 Fork A campaign, PROOF-NEEDS.md." },
  { id = "ADR-002", title = "Fast proof-check CI gate over the proven.ipkg proof modules", status = "accepted", date = "2026-06-01", body = "A required proof-check job runs idris2 --check on each *.Proofs module listed in proven.ipkg (the 29 build-contract proof modules), from the src/ sourcedir with module-relative paths, on a clean idris2-0.8.0 + contrib toolchain (build/ removed so a stale TTC cannot mask a break). This is the fast cone-check recommended in #145 after #127/#145 showed DISCHARGED-but-unbuilt proofs reaching main while the slow full build sat queued. Scope is the ipkg list, not every on-disk Proofs.idr (64 of 93 are intentionally env-blocked or WIP). A corollary of ADR-001: a theorem that can only be closed by consuming an erased 0-multiplicity OWED premise, or an irreducible top-level-constant projection, is itself reverted to OWED rather than given a body that does not type-check. Origin: #147 (gate) and #148 (gate correctness + 5 proof repairs)." },
  { id = "ADR-003", title = "CI builds the standalone Zig FFI surface; full Idris->RefC->Zig integration deferred", status = "accepted", date = "2026-06-01", body = "The e2e.yml E2E and Bench jobs build ffi/zig/build_standalone.zig (src/main.zig only, the pure-Zig C-ABI surface) instead of the default build.zig, because build.zig's idris2_zig_ffi is a Zig .path dependency on the private, sibling-checkout-only repo nextgen-languages/language-bridges, which CI cannot resolve. The Zig toolchain is provisioned via mlugg/setup-zig@v1 at the build.zig.zon minimum (0.15.2). Full Idris->RefC->Zig integration (idris2 --codegen refc + scripts/build-refc.sh + zig build -Didris-*) is documented in docs/ffi-ci-build.md and deferred until language-bridges is provisioned as a submodule plus a CI read credential. Origin: #149; tracked in #151." },
]

[proof-conventions]
# Reference: see PROOF-NEEDS.md "OWED-with-justification convention".
unproven-obligation-pattern = "owed-with-justification"
unproven-obligation-shape = "triple-pipe-doccomment + 0-erased-multiplicity + bare-signature"
banned-tokens-in-proofs-idr = ["believe_me", "idris_crash", "postulate"]
canonical-example = "src/Proven/SafeChecksum/Proofs.idr"
adr-reference = "ADR-001"
